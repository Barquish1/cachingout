{
    "name": "gerry/cachingout",
    "description": "All-in-one WordPress performance optimization plugin.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4",
        "matthiasmullie/minify": "^1.3"
    },
    "require-dev": {
        "php-stubs/wordpress-stubs": "^6.4",
        "php-stubs/woocommerce-stubs": "^8.0",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "phpstan/phpstan": "^1.10",
        "phpunit/phpunit": "^9.6",
        "wp-coding-standards/wpcs": "^3.0",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "lint": "phpcs --standard=phpcs.xml.dist",
        "lint:fix": "phpcbf --standard=phpcs.xml.dist",
        "analyse": "phpstan analyse --memory-limit=1G",
        "test": "phpunit",
        "i18n": "wp i18n make-pot plugin/cachingout plugin/cachingout/languages/cachingout.pot --slug=cachingout --domain=cachingout",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ],
        "build": [
            "@i18n",
            "@check"
        ]
    }
}