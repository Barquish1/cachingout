#: admin/views/wizard/view-wizard-media.php:35
msgid "Enable LazyLoad"
msgstr ""

#: admin/views/view-media.php:40
msgid "Defer loading of images, iframes, and CSS background images until they are about to enter the viewport. Reduces initial page weight and improves Largest Contentful Paint (LCP)."
msgstr ""

#: admin/views/view-media.php:45
msgid "LazyLoad Images"
msgstr ""

#: admin/views/view-media.php:47
msgid "Add loading=\"lazy\" and decoding=\"async\" to all images unless excluded."
msgstr ""

#: admin/views/view-media.php:52
msgid "LazyLoad Iframes"
msgstr ""

#: admin/views/view-media.php:54
msgid "Add loading=\"lazy\" to all iframes (videos, maps, embeds) unless excluded."
msgstr ""

#: admin/views/view-media.php:59
msgid "LazyLoad CSS Background Images"
msgstr ""

#: admin/views/view-media.php:61
msgid "Defer inline CSS background-image loading until the element scrolls into view. Replaces images with a transparent placeholder until then."
msgstr ""

#: admin/views/view-media.php:65
msgid "LazyLoad Videos and Pause Off-screen"
msgstr ""

#: admin/views/view-media.php:67
msgid "Self-hosted videos do not download until they are about to scroll into view; autoplay videos start only while visible and pause when scrolled away. Embedded YouTube and Vimeo players are paused when scrolled out of view. Use the exclusion patterns or data-no-lazy for a hero video that must start immediately."
msgstr ""

#: admin/views/view-media.php:72
msgid "Above-the-Fold Exclusion"
msgstr ""

#: admin/views/view-media.php:78
msgid "Exclude Above-the-Fold Images"
msgstr ""

#: admin/views/view-media.php:80
msgid "Skip lazy-loading for the first images on the page. This ensures the Largest Contentful Paint element loads immediately, improving LCP scores. The browser still loads the rest on demand."
msgstr ""

#: admin/views/view-media.php:85
msgid "Number of Excluded Images"
msgstr ""

#: admin/views/view-media.php:89
msgid "How many images at the top of the page should load immediately without being lazy-loaded. Set to 0 to lazy-load every image."
msgstr ""

#: admin/views/view-media.php:94
msgid "Image Dimensions"
msgstr ""

#: admin/views/view-media.php:100
msgid "Add Missing Width/Height"
msgstr ""

#: admin/views/view-media.php:102
msgid "Read the actual image dimensions from the server and add width and height attributes to images that lack them. Prevents Cumulative Layout Shift (CLS) caused by images loading without reserved space."
msgstr ""

#: admin/views/view-media.php:107
msgid "LCP Image Priority"
msgstr ""

#: admin/views/view-media.php:113
msgid "Prioritise the main above-the-fold image"
msgstr ""

#: admin/views/view-media.php:115
msgid "Finds the image most likely to be the Largest Contentful Paint (usually the hero) and adds fetchpriority=\"high\" plus a preload hint so the browser fetches it before stylesheets, fonts and scripts compete for bandwidth. Respects an existing fetchpriority attribute; never touches lazy-loaded images. A wrong guess only wastes one hint."
msgstr ""

